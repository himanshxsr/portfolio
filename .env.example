# Web3Forms — public access key (safe in browser; get one at https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Server fallback for runtime config (same value; used if public key missing at build)
WEB3FORMS_KEY=

# Optional: Google Apps Script web app URL for auto-replies
GOOGLE_APPS_SCRIPT_URL=

# Optional: Abstract Email Reputation API key (https://app.abstractapi.com/api/email-reputation)
ABSTRACT_EMAIL_API_KEY=

# Supabase CMS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-assets

# Used to HMAC contact-rate-limit identifiers; generate a long random value.
CONTACT_HASH_SECRET=

# One-time local setup only; remove after `npm run cms:create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: place SVG/PDF files in seed/assets/ before running cms:seed
# See seed/README.md
